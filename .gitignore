# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# original (uncompressed) hero videos - kept out of the repo
/_video_originals/

# camera originals sitting in public/ - each one is repacked into the .webp /
# .mp4 that the code actually references, so only the repack belongs in git
/public/bazen/bazen-video.mp4
/public/dogadjaji/d10.jpg
/public/pocetna/FOXY8531.jpg
/public/pocetna/IMG_1855.jpg
/public/pocetna/IMG_3295.jpg
